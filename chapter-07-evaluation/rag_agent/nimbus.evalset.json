            "parts": [
              {
                "text": "What is UN3480?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "UN3480 is the dangerous-goods classification for spare lithium-ion batteries. They must ship by ground transport and cannot go by air freight."
              }
            ],
            "role": "model"
          },
