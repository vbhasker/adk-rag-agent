        {
          "invocation_id": "q01-turn1",
          "user_content": {
            "parts": [
              {
                "text": "What does error E-12 mean?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "E-12 is a battery management system (BMS) fault, such as cell imbalance. Stop using the battery, contact support, and do not open the battery."
              }
            ],
            "role": "model"
          },
          "creation_timestamp": 0.0
        }
      ],
