# Copy to .env. Retrieval works without any key; the ADK agent needs an LLM (Gemini or OpenAI).

# --- Which LLM runs the agents and helper calls ---------------------------------
# gemini (default) | openai
LLM_PROVIDER=gemini

# --- Gemini (pick ONE option) ----------------------------------------------------
# Option A: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-gemini-key

# Option B: Vertex AI (run `gcloud auth application-default login` first)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model used by the agent. If Google has retired it, use the current Flash model name.
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (optional: set LLM_PROVIDER=openai and/or EMBEDDINGS_PROVIDER=openai) ------
# Agents reach OpenAI through ADK's LiteLlm wrapper ("openai/<OPENAI_MODEL>").
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-5-mini                        # any chat model your key can use
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # or text-embedding-3-large
# OPENAI_EMBEDDING_DIM=1536                      # optional: shorten vectors (e.g. 512, 1024)
# OPENAI_BASE_URL=                               # optional: Azure OpenAI / compatible endpoint

# --- Embeddings ---------------------------------------------------------------
# auto | gemini | openai | local | toy
#   auto = gemini if a Google key is set, else openai if OPENAI_API_KEY is set, else local
EMBEDDINGS_PROVIDER=auto
# EMBEDDING_DIM=768                              # Gemini only: 768 | 1536 | 3072
# LOCAL_EMBEDDING_PATH=/path/to/pre-downloaded/onnx-model

# --- Chunking -----------------------------------------------------------------
CHUNK_STRATEGY=markdown        # fixed | sentence | markdown
CHUNK_SIZE=120                 # words
CHUNK_OVERLAP=20               # words
