# Copy to .env and fill in. Everything here is optional in Chapter 2.

# Which embedder: auto | gemini | openai | local | toy
#   auto  = gemini if a Google key/Vertex config is present, else openai if OPENAI_API_KEY is set,
#           else local (fastembed), else toy
EMBEDDINGS_PROVIDER=auto

# Option A: Gemini API key from https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-key-here

# Option B: Vertex AI (uses `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Option C: OpenAI embeddings (set EMBEDDINGS_PROVIDER=openai, or leave auto with only this key set)
# OPENAI_API_KEY=your-openai-key
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # or text-embedding-3-large
# OPENAI_EMBEDDING_DIM=1536                      # optional: shorten vectors (e.g. 512, 1024)
# OPENAI_BASE_URL=                               # optional: Azure OpenAI / compatible endpoint

# Gemini embedding settings
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768                    # Gemini only: 768 | 1536 | 3072 (Matryoshka)

# Local embedding settings
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# LOCAL_EMBEDDING_PATH=/path/to/pre-downloaded/onnx-model   # offline machines only
