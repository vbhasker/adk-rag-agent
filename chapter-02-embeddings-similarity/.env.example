# Copy to .env and fill in. Everything here is optional in Chapter 2.

# Which embedder: auto | gemini | local | toy
#   auto  = gemini if a Google key/Vertex config is present, else local (fastembed), else toy
EMBEDDINGS_PROVIDER=auto

# Option A: Gemini API key from https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-key-here

# Option B: Vertex AI (uses `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Gemini embedding settings
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768                    # 768 | 1536 | 3072 (Matryoshka)

# Local embedding settings
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# LOCAL_EMBEDDING_PATH=/path/to/pre-downloaded/onnx-model   # offline machines only
